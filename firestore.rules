rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Security Definitions (v4)
    // ===============================================================
    //
    // 1. Weekly Leaderboard: /leaderboards/{weekKey}/players/{userId}
    //    - weekKey: string matching '^[0-9]{4}-W[0-9]{2}$'
    //    - userId: string matching authenticated request.auth.uid
    //    - Fields:
    //      * userId: string (must match document ID)
    //      * weekKey: string (must match document path weekKey)
    //      * name: string (length <= 50)
    //      * xp: int (>= 0)
    //      * weekStartMs: int (valid week window relative to request.time)
    //      * updatedAt: timestamp (must equal request.time)
    //    - Constraints & Security:
    //      * Auth requirement: request.auth.token.email_verified == true
    //      * Read: get allowed; list restricted to request.query.limit <= 120
    //      * Delete: owner only
    //      * create: xp <= 25000 (allows initial migration/restore XP)
    //      * update: (reconcile from 0 / uninitialized <= 25000) || (delta <= 10000 && isAcceptableGrowthRate (3 XP/s + 150 margin))
    //
    // 2. All-Time Leaderboard: /leaderboard_alltime/{userId}
    //    - userId: string matching authenticated request.auth.uid
    //    - Fields:
    //      * userId: string (must match document ID)
    //      * name: string (length <= 50)
    //      * totalXp: int (>= 0)
    //      * updatedAt: timestamp (must equal request.time)
    //    - Constraints & Security:
    //      * Auth requirement: request.auth.token.email_verified == true
    //      * Read: get allowed; list restricted to request.query.limit <= 120
    //      * Delete: owner only
    //      * create: totalXp >= 0
    //      * update: totalXp >= old && (new - old) <= 25000 && (reconcile from 0 / uninitialized || isAcceptableGrowthRate (3 XP/s + 150 margin))
    //
    // 3. User Profiles & Subcollections: /users/{userId}
    //    - allow get: true; allow list: false (denied)
    //    - allow write: owner only
    //    - Subcollections: /users/{userId}/{subcollection}/{docId}
    //      * Allowed subcollections: progress, settings, data, sessions, analytics
    //      * allow read, delete: owner only
    //      * allow create, update: owner only with size limits (<= 900,000 chars)
    //        on optional string fields notesJson, wordsJson, progressJson
    //
    // 4. Shared Vocabulary Updates: /shared/vocabulary_updates
    //    - Read: allowed for all
    //    - Write: admin UID 'wB3NVAmBarXHSBrtEzDCriS0XBy2' only
    //
    // 5. Promo Codes: /promo_codes/{codeHash}
    //    - codeHash: SHA-256 hex string (64 lowercase hex chars)
    //    - Fields: active (bool), uses (int), maxUses (int), expiresAt (optional timestamp/null)
    //    - Read: get allowed for authenticated users; list denied
    //    - Create/Delete: admin UID 'wB3NVAmBarXHSBrtEzDCriS0XBy2' only
    //    - Update: admin OR atomic batch redemption (+1 uses, active, uses < maxUses, not expired, redemption doc created in same batch)
    //
    // 6. Promo Redemptions: /promo_redemptions/{redemptionId}
    //    - redemptionId: '{codeHash}_{uid}'
    //    - Fields: uid (string), codeHash (string, 64 hex chars), redeemedAt (timestamp == request.time)
    //    - Read: get allowed for owner matching redemptionId; list denied
    //    - Create: authenticated owner in atomic batch incrementing promo_codes/{codeHash}.uses by 1
    //    - Update/Delete: denied
    //
    // 7. User PRO Entitlements: /users/{userId}/entitlements/{docId}
    //    - docId: 'pro'
    //    - Fields: source ('promo'), codeHash (64 hex chars), grantedAt (timestamp == request.time)
    //    - Read: owner only; Create: owner only with valid promo_redemptions existsAfter; Update/Delete: denied
    //
    // 8. Site Visit Counter: /site_stats/global
    //    - Fields: totalVisits (int), uniqueVisitors (int), appVisits (int), appUniqueVisitors (int), updatedAt (timestamp == request.time)
    //    - Read: get allowed for all; list denied
    //    - Create: each counter int in [0, 1], updatedAt == request.time
    //    - Update: each counter monotonic increment by +0 or +1, updatedAt == request.time
    //    - Delete: denied
    //
    // 9. GA4 Country Statistics Report: /site_stats/ga4_report
    //    - Aggregated, non-PII GA4 country statistics written exclusively by backend Service Account (GitHub Actions / Admin privileges)
    //    - Read: get allowed for all; list denied
    //    - Create/Update/Delete: denied for all clients
    //
    // 10. Daily News Cache: /daily_news/{regionId}
    //     - regionId: 2-letter uppercase ISO country code ('^[A-Z]{2}$') or one of the 36 supported locale codes
    //     - Written exclusively by backend Service Account (GitHub Actions / Admin SDK)
    //     - Read: get allowed for valid country codes or supported locale codes (no auth required for local Google Play Billing Pro); list denied
    //     - Create/Update/Delete: denied for all clients
    //
    // 11. Daily News Active Locales: /news_active_locales/{pairId}
    //     - pairId: '{COUNTRY}_{locale}' matching '^[A-Z]{2}_[a-z]{2}$' (e.g. KZ_ru, UA_ru, UA_uk, US_en)
    //     - Fields:
    //       * country: string (matching '^[A-Z]{2}$')
    //       * locale: string (one of the 36 supported locale codes)
    //       * lastActiveAt: timestamp (must equal request.time)
    //     - Read/List/Delete: denied for all clients (Admin SDK only)
    //     - Create/Update: allowed for valid country+locale pair matching pairId with strict schema and server timestamp
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.uid == 'wB3NVAmBarXHSBrtEzDCriS0XBy2';
    }

    function isValidPromoRedemptionUpdate(codeHash) {
      return isAuthenticated()
        && resource.data.active == true
        && resource.data.uses is int
        && resource.data.maxUses is int
        && resource.data.uses < resource.data.maxUses
        && (!('expiresAt' in resource.data) || resource.data.expiresAt == null || request.time < resource.data.expiresAt)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1
        && !exists(/databases/$(database)/documents/promo_redemptions/$(codeHash + '_' + request.auth.uid))
        && existsAfter(/databases/$(database)/documents/promo_redemptions/$(codeHash + '_' + request.auth.uid));
    }

    function isValidPromoRedemptionCreate(redemptionId) {
      return isAuthenticated()
        && request.resource.data.keys().hasOnly(['uid', 'codeHash', 'redeemedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.codeHash is string
        && request.resource.data.codeHash.matches('^[a-f0-9]{64}$')
        && redemptionId == request.resource.data.codeHash + '_' + request.auth.uid
        && request.resource.data.redeemedAt == request.time
        && !exists(/databases/$(database)/documents/promo_redemptions/$(redemptionId))
        && getAfter(/databases/$(database)/documents/promo_codes/$(request.resource.data.codeHash)).data.uses
           == get(/databases/$(database)/documents/promo_codes/$(request.resource.data.codeHash)).data.uses + 1;
    }

    function isValidPromoEntitlementCreate(userId, docId) {
      return isOwner(userId)
        && docId == 'pro'
        && request.resource.data.keys().hasOnly(['source', 'codeHash', 'grantedAt'])
        && request.resource.data.source == 'promo'
        && request.resource.data.codeHash is string
        && request.resource.data.codeHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.grantedAt == request.time
        && existsAfter(/databases/$(database)/documents/promo_redemptions/$(request.resource.data.codeHash + '_' + userId));
    }

    function getPrevUpdatedAtMillis() {
      return resource.data.updatedAt is timestamp
        ? resource.data.updatedAt.toMillis()
        : (resource.data.updatedAt is int ? resource.data.updatedAt : 0);
    }

    function isAcceptableGrowthRate(newScore, oldScore) {
      let prevTime = getPrevUpdatedAtMillis();
      let delta = math.abs(newScore - oldScore);
      return prevTime == 0 || (
        request.time.toMillis() >= prevTime &&
        delta <= (request.time.toMillis() - prevTime) / 1000 * 3 + 150
      );
    }

    function isValidWeeklyPlayer(userId, weekKey) {
      return weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
        && isOwner(userId)
        && request.auth.token.email_verified == true
        && request.resource.data.userId == userId
        && request.resource.data.weekKey == weekKey
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.weekStartMs is int
        && request.time.toMillis() >= request.resource.data.weekStartMs
        && request.time.toMillis() <= request.resource.data.weekStartMs + (7 * 86400000) + 3600000
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAlltimePlayer(userId) {
      return isOwner(userId)
        && request.auth.token.email_verified == true
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && request.resource.data.totalXp is int
        && request.resource.data.updatedAt == request.time;
    }

    function isValidSiteStatsCreate() {
      return request.resource.data.keys().hasOnly(['totalVisits', 'uniqueVisitors', 'appVisits', 'appUniqueVisitors', 'updatedAt'])
        && request.resource.data.totalVisits is int && request.resource.data.totalVisits >= 0 && request.resource.data.totalVisits <= 1
        && request.resource.data.uniqueVisitors is int && request.resource.data.uniqueVisitors >= 0 && request.resource.data.uniqueVisitors <= 1
        && request.resource.data.appVisits is int && request.resource.data.appVisits >= 0 && request.resource.data.appVisits <= 1
        && request.resource.data.appUniqueVisitors is int && request.resource.data.appUniqueVisitors >= 0 && request.resource.data.appUniqueVisitors <= 1
        && request.resource.data.updatedAt == request.time;
    }

    function isValidSiteStatsUpdate() {
      return request.resource.data.keys().hasOnly(['totalVisits', 'uniqueVisitors', 'appVisits', 'appUniqueVisitors', 'updatedAt'])
        && request.resource.data.totalVisits is int && request.resource.data.totalVisits >= resource.data.totalVisits && request.resource.data.totalVisits <= resource.data.totalVisits + 1
        && request.resource.data.uniqueVisitors is int && request.resource.data.uniqueVisitors >= resource.data.uniqueVisitors && request.resource.data.uniqueVisitors <= resource.data.uniqueVisitors + 1
        && request.resource.data.appVisits is int && request.resource.data.appVisits >= resource.data.appVisits && request.resource.data.appVisits <= resource.data.appVisits + 1
        && request.resource.data.appUniqueVisitors is int && request.resource.data.appUniqueVisitors >= resource.data.appUniqueVisitors && request.resource.data.appUniqueVisitors <= resource.data.appUniqueVisitors + 1
        && request.resource.data.updatedAt == request.time;
    }

    function isSupportedNewsLocale(locale) {
      return locale in ['ar', 'bn', 'bg', 'zh', 'hr', 'cs', 'da', 'en', 'et', 'fi', 'fr', 'de', 'el', 'hi', 'hu', 'id', 'it', 'ja', 'kk', 'ko', 'lv', 'lt', 'fa', 'pl', 'pt', 'ro', 'ru', 'sk', 'sl', 'es', 'sv', 'th', 'tr', 'uk', 'ur', 'vi'];
    }

    function isValidNewsActiveLocaleWrite(pairId) {
      return pairId.matches('^[A-Z]{2}_[a-z]{2}$')
        && request.resource.data.keys().hasOnly(['country', 'locale', 'lastActiveAt'])
        && request.resource.data.keys().hasAll(['country', 'locale', 'lastActiveAt'])
        && request.resource.data.country is string
        && request.resource.data.country.matches('^[A-Z]{2}$')
        && request.resource.data.locale is string
        && isSupportedNewsLocale(request.resource.data.locale)
        && pairId == request.resource.data.country + '_' + request.resource.data.locale
        && request.resource.data.lastActiveAt is timestamp
        && request.resource.data.lastActiveAt == request.time;
    }

    // 1. Weekly Leaderboard
    match /leaderboards/{weekKey}/players/{userId} {
      allow get: if true;
      allow list: if request.query.limit <= 120;
      allow delete: if isOwner(userId);

      allow create: if isValidWeeklyPlayer(userId, weekKey)
        && request.resource.data.xp <= 25000;

      allow update: if isValidWeeklyPlayer(userId, weekKey)
        && (
          ((resource.data.xp == 0 || getPrevUpdatedAtMillis() == 0) && request.resource.data.xp <= 25000)
          || (
            math.abs(request.resource.data.xp - resource.data.xp) <= 10000
            && isAcceptableGrowthRate(request.resource.data.xp, resource.data.xp)
          )
        );
    }

    // 2. All-Time Leaderboard
    match /leaderboard_alltime/{userId} {
      allow get: if true;
      allow list: if request.query.limit <= 120;
      allow delete: if isOwner(userId);

      allow create: if isValidAlltimePlayer(userId)
        && request.resource.data.totalXp >= 0;

      allow update: if isValidAlltimePlayer(userId)
        && request.resource.data.totalXp >= resource.data.totalXp
        && (request.resource.data.totalXp - resource.data.totalXp) <= 25000
        && (
          resource.data.totalXp == 0
          || getPrevUpdatedAtMillis() == 0
          || isAcceptableGrowthRate(request.resource.data.totalXp, resource.data.totalXp)
        );
    }

    // 3. User Profiles and Private Subcollections
    match /users/{userId} {
      allow get: if true;
      allow list: if false;
      allow write: if isOwner(userId);

      match /entitlements/{docId} {
        allow read: if isOwner(userId);
        allow create: if isValidPromoEntitlementCreate(userId, docId);
        allow update, delete: if false;
      }

      match /{subcollection}/{docId} {
        allow read, delete: if isOwner(userId)
          && subcollection in ['progress', 'settings', 'data', 'sessions', 'analytics'];

        allow create, update: if isOwner(userId)
          && subcollection in ['progress', 'settings', 'data', 'sessions', 'analytics']
          && (!('notesJson' in request.resource.data) || (request.resource.data.notesJson is string && request.resource.data.notesJson.size() <= 900000))
          && (!('wordsJson' in request.resource.data) || (request.resource.data.wordsJson is string && request.resource.data.wordsJson.size() <= 900000))
          && (!('progressJson' in request.resource.data) || (request.resource.data.progressJson is string && request.resource.data.progressJson.size() <= 900000));
      }
    }

    // 4. Shared Vocabulary Updates
    match /shared/vocabulary_updates {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == 'wB3NVAmBarXHSBrtEzDCriS0XBy2';
    }

    // 5. Experimental PRO Promo Codes
    match /promo_codes/{codeHash} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidPromoRedemptionUpdate(codeHash);
    }

    // 6. Experimental PRO Promo Redemptions
    match /promo_redemptions/{redemptionId} {
      allow get: if isAuthenticated() && redemptionId.matches('^[a-f0-9]{64}_' + request.auth.uid + '$');
      allow list: if false;
      allow create: if isValidPromoRedemptionCreate(redemptionId);
      allow update, delete: if false;
    }

    // 8. Site Visit Counter
    match /site_stats/global {
      allow get: if true;
      allow list: if false;
      allow create: if isValidSiteStatsCreate();
      allow update: if isValidSiteStatsUpdate();
      allow delete: if false;
    }

    // 9. GA4 Country Statistics Report (backend Service Account write-only)
    match /site_stats/ga4_report {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 10. Daily News Cache (backend Service Account write-only)
    match /daily_news/{regionId} {
      allow get: if regionId.matches('^[A-Z]{2}$') || isSupportedNewsLocale(regionId);
      allow list, create, update, delete: if false;
    }

    // 11. Daily News Active Locales (client heartbeat, Admin SDK read-only)
    match /news_active_locales/{pairId} {
      allow get, list, delete: if false;
      allow create, update: if isValidNewsActiveLocaleWrite(pairId);
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
