rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Weekly Leaderboard:
    // Anyone can read leaderboard standings.
    // An authenticated user can only create or update their own record with valid format.
    match /leaderboards/{weekKey}/players/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0;
    }

    // 2. User Profiles and Private Data:
    // Basic user profile is publicly readable for leaderboard rankings, avatars and podiums.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Private subcollections (progress, favorites, settings, custom words, notes)
      // Strictly accessible ONLY by the account owner
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 3. Shared leaderboard backup document — read-only for all, write only for owner
    match /users/wB3NVAmBarXHSBrtEzDCriS0XBy2/data/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'wB3NVAmBarXHSBrtEzDCriS0XBy2';
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
