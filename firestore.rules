rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Weekly Leaderboard:
    // Anyone can read leaderboard standings.
    // An authenticated user can only create or update their own record in the leaderboard.
    match /leaderboards/{weekKey}/players/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && request.resource.data.userId == userId)
      );
    }

    // 2. User Profiles and Private Data:
    // Basic user profile is publicly readable for leaderboard rankings, avatars and podiums.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email != null
      );

      // Private subcollections (progress, favorites, settings, custom words, notes)
      // Strictly accessible ONLY by the account owner
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.token.email != null
        );
      }
    }

    // 3. Shared leaderboard backup document (administered migration path)
    match /users/wB3NVAmBarXHSBrtEzDCriS0XBy2/data/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
