{
  "name": "my-duolingo",
  "version": "0.1.0",
  "description": "Modern English learning web application",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.cjs",
    "prepare:assets": "node scripts/prepare_android_assets.mjs",
    "build:apk": "node scripts/build_android_apk.mjs",
    "start": "echo Frontend runs as static files",
    "test": "node --test tests/leaderboard.test.mjs tests/leaderboard_e2e_scenarios.test.mjs tests/ad_and_penalties.test.mjs tests/collections.test.mjs tests/monday_ticker.test.mjs tests/monday_meme.test.mjs",
    "test:weekly": "node scripts/weekly_test.mjs",
    "test:weekly:report": "node scripts/weekly_test.mjs --save-report",
    "lint": "echo ESLint will be configured later",
    "format": "echo Prettier will be configured later"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sway-nick/my-duolingo.git"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@google/clasp": "^3.3.0",
    "firebase-admin": "^14.5.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor-community/admob": "^8.2.1"
  }
}
